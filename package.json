{
  "name": "@cafercangundogdu/nestjs-zod-config",
  "version": "0.1.0",
  "description": "Type-safe, decorator-free NestJS configuration with Zod validation and plain constructor injection",
  "author": "Cafer Can Gundogdu",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && pnpm run build:cjs && pnpm run build:esm && node scripts/dist-fixup.mjs",
    "build:cjs": "tsc -p tsconfig.build.json",
    "build:esm": "tsc -p tsconfig.build.esm.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm run typecheck && jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "pnpm run build && pnpm run check:package",
    "prepare": "husky"
  },
  "keywords": [
    "nestjs",
    "config",
    "configuration",
    "zod",
    "validation",
    "type-safe",
    "dependency-injection"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cafercangundogdu/nestjs-zod-config.git"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/config": "^3.0.0 || ^4.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "zod": "^3.20.0 || ^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.4",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "publint": "^0.3.21",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}
