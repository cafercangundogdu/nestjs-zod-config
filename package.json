{
  "name": "@cafercangundogdu/nestjs-zod-config",
  "version": "0.0.2",
  "description": "Type-safe, decorator-free NestJS configuration with Zod validation and plain constructor injection",
  "author": "Cafer Can Gundogdu",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "pnpm run build",
    "prepare": "husky"
  },
  "keywords": [
    "nestjs",
    "config",
    "configuration",
    "zod",
    "validation",
    "type-safe",
    "dependency-injection"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cafercangundogdu/nestjs-zod-config.git"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/config": "^3.0.0 || ^4.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "zod": "^3.20.0 || ^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.7",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/testing": "^11.1.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "publint": "^0.3.18",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  }
}
